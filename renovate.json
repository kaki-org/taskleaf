{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am"
  ],
  "automerge": false,
  "automergeStrategy": "merge-commit",
  "separateMajorMinor": false,
  "labels": [
    "dependencies"
  ],
  "patch": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "bundler"
      ],
      "assignees": [
        "kakikubo"
      ]
    },
    {
      "matchManagers": [
        "bun"
      ],
      "assignees": [
        "kakikubo"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "assignees": [
        "kakikubo"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "patch": {
        "enabled": true
      },
      "automerge": true,
      "platformAutomerge": true,
      "matchPackageNames": [
        "/^@types/",
        "/^rubocop*/",
        "/^rspec*/",
        "/^rack*/",
        "/^spring*/",
        "/^@nuxtjs/eslint/",
        "/^crawler$/",
        "/^eslint/",
        "/^jest/",
        "/^ts-jest$/",
        "/^playwright/",
        "/^http-server$/",
        "/^actions/checkout$/",
        "/^release-drafter/release-drafter$/",
        "/^ruby/setup-ruby$/",
        "/^toshimaru/backlog-pr-link-action$/"
      ]
    },
    {
      "description": "Ruby クライアントと Node ドライバのバージョン不一致を防ぐため同一 PR で更新する",
      "matchPackageNames": [
        "playwright-ruby-client",
        "@playwright/test"
      ],
      "groupName": "playwright",
      "minimumGroupSize": 2,
      "rangeStrategy": "bump"
    },
    {
      "description": "Gemfile / .tool-versions / Dockerfile の Ruby バージョンを同一 PR で更新する",
      "matchDepNames": [
        "ruby"
      ],
      "groupName": "ruby"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "devenv/web/Dockerfile の Ruby イメージタグ（IMAGE_FILE 変数経由）を追従させる",
      "managerFilePatterns": [
        "/^devenv/web/Dockerfile$/"
      ],
      "matchStrings": [
        "FROM \\$\\{?IMAGE_FILE\\}?:(?<currentValue>\\d+\\.\\d+\\.\\d+-alpine)\\s"
      ],
      "depNameTemplate": "ruby",
      "datasourceTemplate": "docker"
    }
  ]
}
